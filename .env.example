# Copy this file to .env and fill in the keys you have.

# Which translation backend the tooltip uses: deepl | claude
TRANSLATOR=deepl

# Free key from https://www.deepl.com/pro-api (DeepL API Free: 500k chars/month)
DEEPL_API_KEY=

# Only needed if TRANSLATOR=claude (https://platform.claude.com)
ANTHROPIC_API_KEY=

# Free key from https://krdict.korean.go.kr/openApi/openApiInfo (optional but recommended)
KRDICT_API_KEY=
