# Copy this file to .env and fill in the keys you have.

# Free key from https://www.deepl.com/pro-api (DeepL API Free: 500k chars/month)
DEEPL_API_KEY=

# Free key from https://krdict.korean.go.kr/openApi/openApiInfo (optional but recommended)
KRDICT_API_KEY=

# Your IANA time zone: decides which local day a read or a saved word counts for.
TZ=Asia/Seoul

# Optional: password for the compose Postgres (default "mbxread"; it listens on 127.0.0.1 only).
# POSTGRES_PASSWORD=
